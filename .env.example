# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # NEVER expose to frontend

# ─── Twilio (calls + texts for onboarded clients) ────────────────────────────
# Each client texts from their own number (clients.twilio_number, set by
# scripts/onboard.js). TWILIO_DEFAULT_FROM is for system texts (admin alerts)
# and clients without their own number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_DEFAULT_FROM=+1xxxxxxxxxx

# ─── TextBelt SMS (fallback for clients without a Twilio number) ─────────────
TEXTBELT_API_KEY=textbelt                              # "textbelt" = free 1/day; use paid key in prod

# ─── Alerts ──────────────────────────────────────────────────────────────────
ADMIN_ALERT_PHONE=+1xxxxxxxxxx                         # you — texted when a call errors out
DASHBOARD_URL=https://your-app.vercel.app              # link in owner texts + review links (defaults to VERCEL_DOMAIN)

# ─── Vapi ────────────────────────────────────────────────────────────────────
VAPI_API_KEY=your_vapi_api_key_here                   # Vapi dashboard → API Keys (for setup script)
VAPI_WEBHOOK_SECRET=your_random_webhook_secret_here   # shared secret for all Vapi tool endpoints

# Provisioning (scripts/onboard.js locally via .env.local, and /api/admin/provision on Vercel)
# DEPLOYMENT_URL=https://your-app.vercel.app
# TEMPLATE_ASSISTANT_ID=...    # an assistant whose model/voice/transcriber new clients copy (e.g. the demo agent)

# ─── CRM admin API (/api/admin/:action) ─────────────────────────────────────
# Shared secret the CRM (nickbuilds.org) sends as "Authorization: Bearer ...".
# Set the same value as RECEPTIONIST_ADMIN_SECRET in the CRM project.
ADMIN_API_SECRET=your_random_admin_api_secret_here
# Messaging Service on your approved A2P 10DLC campaign — "Attach to A2P"
# adds each new number to it. Set its Incoming Messages to "Defer to sender's webhook".
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Platform ────────────────────────────────────────────────────────────────
VERCEL_DOMAIN=your-app.vercel.app                     # no https://
JWT_SECRET=your_random_jwt_secret_here
CRON_SECRET=your_random_cron_secret_here

# ─── Auth ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your_platform_admin_password           # logs in as admin (sees all clients)
# Client passwords live in clients.dashboard_password (Supabase) — not env vars

# ─── Google Calendar (bookAppointment tool) ─────────────────────────────────────
# Paste the FULL contents of a Google service-account JSON key as one value.
# Share the target calendar with the service account's client_email
# ("Make changes to events") and set clients.calendar_id (see sql/007_*.sql).
# GOOGLE_SERVICE_ACCOUNT_JSON is also accepted (same value) if you're reusing
# the credentials from another project that uses that name.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ─── Deprecated (moved to clients table) ────────────────────────────────────
# VAPI_AGENT_ID         → clients.agent_id
# DOCTOR_EMERGENCY_PHONE → clients.doctor_phone
# FRONT_DESK_PHONE       → clients.front_desk_phone
# DASHBOARD_PASSWORD     → clients.dashboard_password
# TIMEZONE               → clients.timezone

# ─── Lead capture (/api/leads/:source) ──────────────────────────────────────
# Lead emails: Cloudflare Email Routing → cloudflare/lead-email-worker → /api/leads/email.
# Each client's address is <slug>.<key>@LEAD_EMAIL_DOMAIN (shown in the CRM).
LEAD_EMAIL_DOMAIN=leads.nickbuilds.org
LEAD_EMAIL_SECRET=your_random_secret_shared_with_the_worker

# ─── Jobber (review requests after jobs, quote follow-up) ───────────────────
# Developer Center app: redirect https://<this app>/api/leads/jobber-callback,
# webhook https://<this app>/api/leads/jobber (visit/job completed, quote sent).
# JOBBER_CLIENT_ID=
# JOBBER_CLIENT_SECRET=
# JOBBER_API_VERSION=2025-04-16

# ─── Email (optional — monthly scorecard copy to the owner) ─────────────────
# RESEND_API_KEY=
# RESEND_FROM=NickBuilds <reports@nickbuilds.org>
